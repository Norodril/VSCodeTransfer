Demo 4: Composite index (customer_id, order_date)
-First, sort by customer id, then sort by order date 
```{r}
dbExecute(PSTAT132db, "CREATE INDEX idx_orders_cust_date ON 
          orders(customer_id, order_date);")
dbExecute(PSTAT132db, "ANALYZE;") #analyze collects statistics about database tables and indexes so SQLite can make better decisions about how to execute queries
#it collects info about the data and indexes, and then SQLite uses those stats to help decide whether using an index will be faster than scanning the table 


#Query that can use left-most prefix 
sql_cust_date <- "
SELECT * FROM orders
WHERE customer_id = 1234 AND order_date BETWEEN '2020-0601' AND '2020-06-30';
"

print(dbGetQuery(PSTAT132db, paste0("EXPLAIN QUERY PLAN ", 
                                    sql_cust_date)))
system.time(dbGetQuery(PSTAT132db, sql_cust_date))

#Query that does NOT match left-most prefix 
sql_date_only <- "
SELECT * FROM orers
WHERE order_date BETWEEN '202-06-01' AND '2020-06-30';
"
print(dbGetQuery(PSTAT132db, paste0("EXPLAIN QUERY PLAN", 
                                    sql_date_only)))
system.time(dbGetQuery(PSTAT132db, sql_date_only))

```


Demo 5: Covering index (customer_id, order_date, amount)
A covering index is an index that contains all the columns a query needs, so the database can answer the query using the index without looking up the original table rows
```{r}
dbExecute(PSTAT132db, "CREATE INDEX idx_orders_cover ON
orders(customer_id, order_date, amount);
")
#update database statistics 
dbExecute(PSTAT132db, "ANALYZE;")

#everything required in the query is covered in the index 
sql_cover <- "
SELECT order_date, amount
FROM orders
WHERE customer_id = 1234
AND order_date >= '2023-01-01'
AND order_date < '2023-02-01'
ORDER BY order_date;
"

#calls previously defined explain_plan() helper function to show SQLite's execution plan
print(explain_plan(sql_cover))
#calls previously defined 'time_query()' helper function and prints its 'time' results
print(time_query(sql_cover)$time)

system.time(dbGetQuery(PSTAT132db, sql_cover))

#Example- measurable duration (timing out 1000 repetitions)
timing <- system.time({
  for(i in seq_len(1000)) {
    res_cover <- dbGetQuery(PSTAT132db, sql_cover)
  }
})
print(timing)
print(timing[["elapsed"]]/1000)
```

