Demo 7: Create partial index on only pending order
```{r}
#A partial index indexes only the rows that satisfy a specified condition
#Here, the index orders by customer id whose status is 'PENDING'
dbExecute(PSTAT132db, "CREATE INDEX idc_orders_pending ON 
          orders(customer_id) WHERE status = 'PENDING';
          ")
dbExecute(PSTAT132db, "ANALYZE;")

#Query that benefits
sql_pending <- "SELECT * 
FROM orders 
WHERE customer_id = 1234 AND status = 'PENDING';"
print(dbGetQuery(PSTAT132db, paste0("EXPLAIN QUERY PLAN ", sql_pending))) #paste0() is an R function that joins pieces of text together without adding spaces between them
system.time(dbGetQuery(PSTAT132db, sql_pending))

dbDisconnect(PSTAT132db)
```
