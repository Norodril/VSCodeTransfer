
```{r setup, include=FALSE}
knitr::opts_chunk$set(echo = TRUE)
library(DBI)
library(RSQLite)
library(dplyr)
library(dbplyr)
library(tibble)
library(lubridate)

PSTAT132db <- dbConnect(RSQLite::SQLite(), "PSTAT132-db.sqlite")
dbRemoveTable(PSTAT132db, 'orders')
dbRemoveTable(PSTAT132db, 'customers')
dbListTables(PSTAT132db)

#Create Schema
dbExecute(PSTAT132db, "
          CREATE TABLE customers (
          customer_id INTEGER PRIMARY KEY, 
          name TEXT, 
          state TEXT
          );
          ")

dbExecute(PSTAT132db, "
          CREATE TABLE orders (
          order_id INTEGER PRIMARY KEY,
          customer_id INTEGER,
          order_date TEXT, 
          status TEXT, 
          amount NUMERIC
          );
          ")

#Populating tables with synthetic but repeatable data
set.seed(42)
n_customers <- 5000
n_orders <- 80000

# customers
customers <- data.frame(
customer_id = seq_len(n_customers),
name = paste0('C', sprintf('%05d', seq_len(n_customers))),
state = sample(c('CA','NY','TX','WA','FL','MA'), n_customers, replace =
TRUE),
stringsAsFactors = FALSE
)
dbWriteTable(PSTAT132db, "customer", customers, append = TRUE, row.names
= FALSE)

# orders: skewed customer distribution, dates in 2020, mixed statuses,
random amounts
cust_ids <- sample.int(n_customers, n_orders, replace = TRUE,
prob = rexp(n_customers, rate = 1 / n_customers))
order_dates <- as.Date("2020-01-01") + sample(0:365, n_orders, replace =
TRUE)
statuses <- sample(c("PENDING","SHIPPED","CANCELLED","RETURNED"),
n_orders, replace = TRUE,
prob = c(0.2,0.6,0.1,0.1))
amounts <- round(runif(n_orders, 5, 500), 2)
orders <- data.frame(
order_id = seq_len(n_orders),
customer_id = cust_ids,
order_date = format(order_dates, "%Y-%m-%d"),
status = statuses,
amount = amounts,
stringsAsFactors = FALSE
)

# Write orders
dbWriteTable(PSTAT132db, "orders", orders, append = TRUE, row.names =
FALSE)

#Helper: explain plan + timed execution
explain_plan <- function(sql) {
dbGetQuery(PSTAT132db, paste0("EXPLAIN QUERY PLAN ", sql))
}
time_query <- function(sql) {
t <- system.time(res <- dbGetQuery(PSTAT132db, sql))
list(time = t, nrows = if (is.data.frame(res)) nrow(res) else NA,
result = res)
}
```

