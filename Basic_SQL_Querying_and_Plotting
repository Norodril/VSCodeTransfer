```{r}
PSTAT132db <- dbConnect(RSQLite::SQLite(), "PSTAT132-db.sqlite")

#helper to convert date-like columns returned from DB into R Date objects
#using this code when required
convert_date_cols <- function(df) {
  if(!is.data.frame(df)) return(df)
  date_cols <- grep("date", tolower(names(df)), value = TRUE)
  for (col in date_cols) {
    if (!inherits(df[[col]], "Date")){
      if(is.character(df[[col]])) {
        parsed <- as.Date(df[[col]])
        if(all(is.na(parsed)) && requireNamespace("lubridate", quietly = TRUE)) {
          parsed <- lubridate::ymd(df[[col]])
        }
        df[[col]] <- parsed
      } else if (is.numeric(df[[col]])) {
        df[[col]] <- as.Date(df[[col]], origin = "1970-01-01")
      } else {
        df[[col]] <- as.Date(df[[col]])
      }
    }
  }
  df

    
}


```


