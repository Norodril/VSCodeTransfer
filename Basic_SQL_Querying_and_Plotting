Demo 2- Aggregation with GROUP BY: total sales per region
```{r}
sales_by_region <- dbGetQuery(PSTAT132db, "
                              SELECT c.region, COUNT(o.order_id) AS n_orders, SUM(o.amount) AS total_sales, ROUND(AVG(o.amount), 2) AS avg_order
                              FROM orders o
                              JOIN customers c ON o.customer_id = c.customer_id --joining for region 
                              GROUP BY c.region
                              ORDER BY total_sales DESC; --ordering by total sales from region largest to smallest
                              ")
print(sales_by_region)

unique_products_sold <- dbGetQuery(PSTAT132db, "
                                   SELECT COUNT(DISTINCT product_id) AS n_unique_products FROM orders;
                                   ")
print(unique_products_sold)

#HAVING: region with total_sales > 200
big_regions <- dbGetQuery(PSTAT132db, "
                          SELECT c.region, SUM(o.amount) AS total_sales
                          FROM orders o JOIN customers c ON o.customer_id = c.customer_id
                          GROUP BY c.region
                          HAVING SUM(o.amount) > 200 --regions where the total amount > 200
                          ORDER BY total_sales DESC;
                          ") %>% as_tibble()
print(big_regions)
```

Demo 3- Proportion / percent: percent of total revenue by product category
```{r}
#calculates what percentage of the total revenue comes from each product category
pct_by_category <- dbGetQuery(PSTAT132db, "
                              WITH category_totals AS( --first CTE calculates sales for each category
                              SELECT p.category, SUM(o.amount) AS category_sales
                              FROM orders o
                              JOIN products p ON o.product_id = p.product_id
                              GROUP BY p.category --category and category_sales hold the total sales for each category
                              ), grand AS( --Another CTE called grand 
                              SELECT SUM(category_sales) AS grand_total  --adds every category from previous CTE together 
                              FROM category_totals
                              )
                              SELECT c.category, c.category_sales,
                              ROUND(100.0 *c.category_sales / g.grand_total, 2) AS pct_of_total --fraction times 100 to calculate percentage of total coming from each category
                              FROM category_totals c, grand g
                              ORDER BY c.category_sales DESC --sort result from highest category revenue to lowest (descending order)
                              ")
print(pct_by_category)
```

Demo 4: Multi-column grouping (total sales by region and category)
```{r}
sales_region_category <- dbGetQuery(PSTAT132db, "
                                    SELECT c.region, p.category, SUM(o.amount) AS total_sales, COUNT(*) AS n_orders --region, category, total sales, n_orders 
                                    FROM orders o  --Joining tables 
                                    JOIN customers c ON o.customer_id = c.customer_id
                                    JOIN products p ON o.product_id = p.product_id
                                    GROUP BY c.region, p.category --region and category combos determine the groups and ordering these groups by total region first then largest to smallest total sales
                                    ORDER BY c.region, total_sales DESC;
                                    ")

print(sales_region_category)
```

Demo 5: Manual rollup pattern: grand totals and subtotals 
```{r}
#UNION ALL grouped queries to simulate rollups (an extension of GROUP BY)
#uses UNION ALL to stack 3 separate SQL queries together 
#Think of UNION ALL as stacking tables vertically
rollup_sim <- dbGetQuery(PSTAT132db, "
--region, category, sum for each group, and level telling you that these rows are the detailed totals
                         SELECT region, category, SUM(amount) AS total_sales, 'detail' AS level FROM(
                         SELECT c.region, p.category, o.amount
                         --joining orders, customers, and products since we want each order to have its region, category, and amount together 
                         FROM orders o 
                         JOIN customers c ON o.customer_id = c.customer_id 
                         JOIN products p ON o.product_id = p.product_id
                         )
                         GROUP BY region, category --want one group for each unique combo of region and category
                         UNION ALL
                         --2nd query: calculating total sales for each region 
                         SELECT region, NULL AS category, SUM(amount) AS total_sales, 'region_total' FROM(
                         SELECT c.region, p.category, o.amount
                         FROM orders o 
                         JOIN customers c ON o.customer_id = c.customer_id 
                         JOIN products p 
                         ON o.product_id = p.product_id
                         ) GROUP BY region --only groups by region, meaning we want region, cateogry, and total sales per category; set category to null since we do not want to filter by categories in this query
                         UNION ALL 
                         SELECT NULL AS region, NULL AS category, SUM(amount) AS total_sales, 'grand_total' FROM orders --calculates the total sales across all orders
                         --this query only uses orders since the grad total only needs the order amounts 
                         ")

print(rollup_sim)
```
Demo 6- EXPLAIN QUERY PLAN example- check aggregation on orders grouped by product_id 
```{r}
#Actual query asks SQLite to look at the 'orders' table, group orders that have the same product_id, and add up the amount for each product
explain_plan <- dbGetQuery(PSTAT132db, "EXPLAIN QUERY PLAN 
                           SELECT product_id, SUM(amount) 
                           FROM orders
                           GROUP BY product_id;")

print(explain_plan)
```
Output means
SCAN orders- SQLite scans the 'orders table to read the rows it needs 
USE TEMP B-TREE FOR GROUP BY - SQLite uses a temporary sorting/grouping structure to organize rows by 'product_id' and calculate each groups' sum 
Temporary B-tree is an internal data structure SQLite can use to organize data for operations such as grouping, sorting, and removing duplicates. It is not necessarily a permanent index saved in the database

Demo 7- dpblyr equivalents (dplyr pipelines against the database)
```{r}
orders_tbl <- tbl(PSTAT132db, "orders")
customers_tbl <- tbl(PSTAT132db, "customers")
products_tbl <- tbl(PSTAT132db, "products")

#Example- sales by region using dblyr
sales_by_region_dpy <- orders_tbl %>%
  inner_join(customers_tbl, by = "customer_id") %>%
  group_by(region) %>%
  summarise(
    n_orders = n(),
    total_sales = sum(amount, na.rm = TRUE),
    avg_order = round(mean(amount, na.rm = TRUE), 2)
  ) %>% 
  arrange(desc(total_sales))

#Show that the SQL dbplyr runs 
show_query(sales_by_region_pdy)
#execute and pull results into R as a tibble
sales_by_region_df <- sales_by_region_dpy %>% collect()
print(sales_by_region_df)

#SQL alternative
sales_by_region_sql <- dbGetQuery(PSTAT132db, "
                                  SELECT c.region,
                                  COUNT(o.order_id) AS n_orders,
                                  SUM(o.amount) AS total_sales,
                                  ROUND(AVG(o.amount), 2) AS avg_order
                                  FROM orders o 
                                  JOIN customers c ON o.customer_id = c.customer_id
                                  GROUP BY c.region
                                  ORDER BY total_sales DESC;
                                  ")

#check
stopifnot(is.data.frame(sales_by_region))
is.data.frame(sales_by_region)


#prepare a summary for plotting: percent by category (dbplyr + CTE-like pipe)
pct_by_category_dpy <- orders_tbl %>%
  inner_join(products_tbl, by = "product_id") %>%
  group_by(category) %>%
  summarise(category_sales = sum(amount, na.rm = TRUE)) %>% 
  mutate(pct_of_total = round(100 * category_sales/sum(category_sales), 2)) %>%
  arrange(desc(category_sales))

show_query(pct_by_category_dpy)

pct_by_category_df <- pct_by_category_dpy %>% collect()
print(pct_by_category_df)

#Chart- percent by category
ggplot(pct_by_category_df, aes(x = reorder(category, -category_sales), y = category_sales, fill = category)) +
  geom_col(show.legend = FALSE) +
  labs(title = "Sales by category", x = "Category", y = "Total sales") + 
  theme_minimal()

  
```
