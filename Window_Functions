```{r}
PSTAT132db <- dbConnect(RSQLite::SQLite(), "PSTAT132-db.sqlite") #connects to the database and resets it

dbListTables(PSTAT132db)

#Helper: Convert any columns with 'date' in their name to Date class in R
#This function takes a data frame and converts every column with "date" in its name
#Ie. 'order_date', 'shipDate' into R's Date class 
#if the input isn't a data frame, the function returns it unchanged. Otherwise it returns the data frame with the converted columns 
convert_date_cols <- function(df) {
  if (!is.data.frame(df)) return(df)
  date_cols <- grep("date", names(df), ignore.case = TRUE, value = TRUE)
  for (col in date_cols) {
    if (!inherits(df[[col]], "Date")) {
      if (is.character(df[[col]])) {
        parsed <- as.Date(df[[col]], optional = TRUE)
          #fallback to lubridat:: ymd if available and character parson fails
          if (all(is.na(parsed)) && requireNamespace("lubridate", quietly = TRUE)) {
            parsed <- lubridate::ymd(df[[col]])
          }
          df[[col]] <- parsed
        } else if (is.numeric(df[[col]])) {
          df[[col]] <- as.Date(df[[col]], origin = "1970-01-01")
        } else{
          df[[col]] <- as.Date(df[[col]])
        }
      }
    }
  df
}

```

