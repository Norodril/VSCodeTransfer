Demo 2: 
Basic SQL queries via DBI 
```{r}
#Retrieves all columns and all rows
all_products <- dbGetQuery(PSTAT132db, "SELECT * FROM products;")
print(all_products)

#Retrieve just the names and category
names_and_categories <- dbGetQuery(PSTAT132db, "SELECT product_name, category FROM products;")
print(names_and_categories)

#Filter using WHERE
expensive_items <- dbGetQuery(PSTAT132db, "
                              SELECT product_name, price
                              FROM products
                              WHERE price > 100.000;
                              ")
print(expensive_items)

#Sort using ORDER BY
sorted_products <- dbGetQuery(PSTAT132db, "
                              SELECT * 
                              FROM products
                              ORDER BY price DESC;
                              ")
print(sorted_products)

#finding the top 1 most expensive item using ORDER BY and LIMIT
top_item <- dbGetQuery(PSTAT132db, "
                       SELECT product_name, price
                       FROM products
                       ORDER BY price DESC
                       LIMIT 1;
                       ")
print(top_item)
```

Complex Filtering
```{r}
#returns a product if either it is in the Electronics category AND its price is Less than 500$, or its product name contains 'Note' somewhere in it 
#the parenthesis group the first 2 conditions together 
#SQL naturally evaluates AND before OR 
complex_query <- dbGetQuery(PSTAT132db, "
                            SELECT product_name, category, price
                            FROM products
                            WHERE (category = 'Electronics' AND price < 500.00)
                            OR product_name LIKE '%Note%';
                            ")
print(complex_query)
```

Demo 3: Filtered Query (WHERE) and sorting (ORDER BY)
```{r}
#JOIN and INNER JOIN mean the exact same thing in SQL 
q2 <- dbGetQuery(PSTAT132db, "
                 SELECT o.order_id, o.order_date, o.amount, c.name AS customer
                 FROM orders o
                 JOIN customers c ON o.customer_id = c.customer_id
                 WHERE amount > 80
                 ORDER BY amount DESC;
                 ")
print(q2)

#Aggregation: total sales by region (GROUP BY + HAVING)
#COUNT(*)- the 'orders' table has one row for each order. 
q3 <- dbGetQuery(PSTAT132db, "
                 SELECT c.region, SUM(o.amount) AS total_sales, COUNT(*) AS n_orders
                 FROM orders o
                 JOIN customers c ON o.customer_id = c.customer_id
                 GROUP BY c.region
                 HAVING SUM(o.amount) > 150
                 ORDER BY total_sales DESC;
                 ")
print(q3)
```


Here, COUNT(*) counts all rows in the group, meaning it counts the number of orders per region, since we grouped by c.region

